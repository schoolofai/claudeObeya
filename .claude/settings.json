{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/obeya/hooks/obeya_hook.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/obeya/hooks/obeya_hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Read|TaskCreate|TaskUpdate|TaskList|TaskGet|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/obeya/hooks/obeya_hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|TaskCreate|TaskUpdate|TaskList|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/obeya/hooks/obeya_hook.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/obeya/hooks/obeya_hook.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/obeya/hooks/obeya_hook.py"
          }
        ]
      }
    ]
  }
}
